{
    "layer": "top",
    "position": "top",
    "height": 30,
    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "wireplumber",
        "network",
        "battery",
        "clock"
    ],
    "wireplumber": {
        "format": "",
        "format-muted": "",
        "format-icons": [
            "",
            "",
            ""
        ],
        "on-click": "~/.config/waybar/popups/audio.sh"
    },
    "network": {
        "format-wifi": "󰖩",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰖪",
        "tooltip-format-wifi": "{essid}\n{signalStrength}%",
        "on-click": "~/.config/waybar/popups/network.sh"
    },
    "battery": {
        "format": "{icon}",
        "format-charging": "󰂄",
        "format-icons": [
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],
        "on-click": "~/.config/waybar/popups/battery.sh"
    },
    "clock": {
        "format": "{:%H:%M:%S}",
        "on-click": "swaync-client -t"
    },
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "I",
            "2": "II",
            "3": "III",
            "4": "IV",
            "5": "V"
        },
        "persistent-workspaces": {
            "*": 5
        }
    }
}
