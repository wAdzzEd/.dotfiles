{
    "$schema": "/etc/xdg/swaync/configSchema.json",
    "ignore-gtk-theme": true,
    "positionX": "right",
    "positionY": "top",
    "layer": "overlay",
    "control-center-layer": "top",
    "layer-shell": true,
    "layer-shell-cover-screen": true,
    "cssPriority": "user",
    "control-center-margin-top": 12,
    "control-center-margin-bottom": 12,
    "control-center-margin-right": 12,
    "control-center-margin-left": 12,
    "control-center-width": 460,
    "control-center-height": 760,
    "notification-window-width": 460,
    "fit-to-screen": true,
    "notification-2fa-action": true,
    "notification-inline-replies": false,
    "notification-body-image-height": 100,
    "notification-body-image-width": 200,
    "timeout": 8,
    "timeout-low": 5,
    "timeout-critical": 0,
    "relative-timestamps": true,
    "keyboard-shortcuts": true,
    "notification-grouping": true,
    "image-visibility": "when-available",
    "transition-time": 200,
    "hide-on-clear": false,
    "hide-on-action": true,
    "text-empty": "Aucune notification",
    "script-fail-notify": true,
    "widgets": [
        "title",
        "calendar",
        "notifications",
        "mpris",
        "buttons-grid"
    ],
    "widget-config": {
        "title": {
            "text": "Notifications",
            "clear-all-button": true,
            "button-text": "Clear"
        },
        "calendar": {
            "show-day-label": false,
            "show-date-label": false,
            "show-heading": true,
            "show-day-names": true,
            "show-week-numbers": false,
            "day-format": "%A",
            "date-format": "%d %B %Y"
        },
        "notifications": {
            "vexpand": true
        },
        "mpris": {
            "blacklist": [],
            "autohide": true,
            "show-album-art": "always",
            "loop-carousel": false
        },
        "buttons-grid": {
            "buttons-per-row": 3,
            "actions": [
                {
                    "label": "󰤄",
                    "type": "button",
                    "command": "systemctl suspend"
                },
                {
                    "label": "󰜉",
                    "type": "button",
                    "command": "systemctl reboot"
                },
                {
                    "label": "󰐥",
                    "type": "button",
                    "command": "systemctl poweroff"
                }
            ]
        }
    }
}
